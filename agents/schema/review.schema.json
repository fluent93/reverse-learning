{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fluent93/reverse-learning/agents/schema/review.schema.json",
  "title": "RLF Critic Review",
  "description": "Structured output schema for Agent 02 (Critic). Every reviews/v{n}-review.json must conform to this schema.",
  "type": "object",
  "required": [
    "schema_version",
    "draft_version",
    "reviewed_at_utc",
    "reviewer_agent",
    "rubric_version",
    "dimensions",
    "total_score",
    "recommendation",
    "top_issues"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "draft_version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Which drafts/v{n}.md this review is for."
    },
    "reviewed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_agent": {
      "type": "string",
      "const": "critic"
    },
    "model_intent": {
      "type": "string",
      "description": "Self-reported model identifier from the Critic invocation."
    },
    "rubric_version": {
      "type": "string",
      "description": "Version of agents/rubrics/rlf-core-rubric.md used."
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "paper",
        "checklist",
        "rubric",
        "guide",
        "one_pager",
        "blog_source",
        "education"
      ]
    },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "max_points",
          "score",
          "evidence",
          "gaps",
          "severity_breakdown"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "conceptual_clarity",
              "epistemic_honesty",
              "evidence_and_verification",
              "dialogic_quality",
              "contextual_relevance",
              "structural_reconstruction",
              "ownership_and_defensibility"
            ]
          },
          "name": {
            "type": "string"
          },
          "max_points": {
            "type": "integer",
            "enum": [
              10,
              15,
              20
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 5,
            "description": "Short quotes from the draft anchoring the score."
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific, actionable problems. Each is a separate string."
          },
          "severity_breakdown": {
            "type": "object",
            "required": [
              "blocker",
              "major",
              "minor"
            ],
            "additionalProperties": false,
            "properties": {
              "blocker": {
                "type": "integer",
                "minimum": 0
              },
              "major": {
                "type": "integer",
                "minimum": 0
              },
              "minor": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "total_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Sum of dimension scores. The Orchestrator validates that this equals the sum."
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "FINALIZE",
        "REVISE"
      ]
    },
    "top_issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "dimension_id",
          "issue",
          "why_it_matters",
          "desired_property"
        ],
        "additionalProperties": false,
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "dimension_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "issue": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "desired_property": {
            "type": "string",
            "description": "What a fixed version would exhibit. NOT a rewritten sentence — a property description."
          }
        }
      }
    },
    "out_of_rubric_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Issues that do not map to any rubric dimension. Do not affect total_score."
    },
    "calibration_anchor_band": {
      "type": "string",
      "enum": [
        "95-100",
        "85-94",
        "70-84",
        "50-69",
        "below-50"
      ],
      "description": "Which calibration band the Critic believes this draft falls into. Helps detect score drift over time."
    }
  }
}
